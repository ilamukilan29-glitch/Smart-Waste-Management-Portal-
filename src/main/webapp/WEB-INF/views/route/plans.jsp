<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<c:set var="pageTitle" value="Optimized Collection Plans" scope="request"/>
<jsp:include page="../common/header.jsp"/>
<jsp:include page="../common/sidebar.jsp"/>

<div class="app-main">
    <jsp:include page="../common/navbar.jsp"/>

    <main class="app-content">
        <jsp:include page="../common/alerts.jsp"/>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Optimized Collection Plans</h4>
                <p class="text-muted small">Historical and scheduled route plans generated by the Nearest Neighbor algorithm.</p>
            </div>
            <div>
                <c:if test="${sessionScope.LOGGED_IN_USER.role == 'ADMIN'}">
                    <a href="${pageContext.request.contextPath}/routes/plan" class="btn btn-success btn-sm shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Generate New Route Plan
                    </a>
                </c:if>
            </div>
        </div>

        <div class="card card-municipal">
            <div class="card-header">
                <span class="fw-bold">Generated Plans (${plans.size()} records)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-municipal table-hover mb-0">
                    <thead>
                    <tr>
                        <th>Plan Code</th>
                        <th>Area & Depot</th>
                        <th>Vehicle</th>
                        <th>Scheduled Date</th>
                        <th>Distance</th>
                        <th>Duration</th>
                        <th>Waste Load</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    <c:choose>
                        <c:when test="${empty plans}">
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-signpost-split fs-2"></i>
                                    <p class="mt-2 mb-0">No collection plans generated yet.</p>
                                </td>
                            </tr>
                        </c:when>
                        <c:otherwise>
                            <c:forEach var="plan" items="${plans}">
                                <tr>
                                    <td>
                                        <a href="${pageContext.request.contextPath}/routes/details?id=${plan.id}" class="fw-bold text-success text-decoration-none">
                                            <c:out value="${plan.planCode}"/>
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><c:out value="${plan.areaName}"/></div>
                                        <div class="small text-muted"><c:out value="${plan.depotName}"/></div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border"><c:out value="${plan.vehicleRegistration != null ? plan.vehicleRegistration : 'Unassigned'}"/></span></td>
                                    <td><c:out value="${plan.plannedCollectionDate}"/></td>
                                    <td class="fw-bold text-success"><fmt:formatNumber value="${plan.totalDistanceKm}" maxFractionDigits="2"/> km</td>
                                    <td>${plan.estimatedDurationMinutes} min</td>
                                    <td><fmt:formatNumber value="${plan.totalWasteEstimatedKg}" maxFractionDigits="1"/> kg</td>
                                    <td>
                                        <span class="badge ${plan.status == 'COMPLETED' ? 'bg-success' : (plan.status == 'IN_PROGRESS' ? 'bg-warning text-dark' : (plan.status == 'ASSIGNED' ? 'bg-primary' : 'bg-secondary'))}">
                                            <c:out value="${plan.status.displayName}"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="${pageContext.request.contextPath}/routes/details?id=${plan.id}" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> View Stops
                                        </a>
                                    </td>
                                </tr>
                            </c:forEach>
                        </c:otherwise>
                    </c:choose>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

<jsp:include page="../common/footer.jsp"/>
